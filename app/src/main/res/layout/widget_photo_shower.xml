<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/photo_shower_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="0dp">

    <!-- Journal Photo Display -->
    <ImageView
        android:id="@+id/photo_shower_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/sample_journal_photo"
        android:contentDescription="Journal Photo" />

    <!-- Dark gradient shadow overlay at bottom for maximum title readability -->
    <View
        android:id="@+id/photo_bottom_shadow"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_alignParentBottom="true"
        android:background="#B3000000" />

    <!-- Top Left Corner Date Badge in DD/MM/YY format -->
    <LinearLayout
        android:id="@+id/photo_date_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginStart="10dp"
        android:background="#C0000000"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/photo_shower_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14/08/26"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Top Right Corner Next Photo Button -->
    <ImageView
        android:id="@+id/btn_next_photo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginEnd="8dp"
        android:background="#90000000"
        android:padding="6dp"
        android:src="@android:drawable/ic_popup_sync"
        android:contentDescription="Next Photo" />

    <!-- Bottom Caption Layout for Journal Details -->
    <LinearLayout
        android:id="@+id/photo_shower_caption_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/photo_shower_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sunset Memories"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/photo_shower_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Golden hour by the lake with calm breeze and reflections..."
            android:textColor="#E0E0E0"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Empty State Layout when no photos exist in Journal -->
    <LinearLayout
        android:id="@+id/photo_shower_empty_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/photo_shower_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="No photos in journal"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/photo_shower_empty_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Add photos to your Journal entries to shower them here! Tap to open journal."
            android:textColor="#B0BEC5"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Error State Layout when loading or decoding encounters an error -->
    <LinearLayout
        android:id="@+id/photo_shower_error_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/photo_shower_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Photo Widget Error"
            android:textColor="#FF8A80"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/photo_shower_error_reason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Reason: Unknown error"
            android:textColor="#FFCDD2"
            android:textSize="10sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/btn_photo_error_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_button_background"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Tap to Retry"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
