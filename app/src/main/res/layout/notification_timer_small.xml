<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/notif_timer_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_timer_red_clock"
        android:contentDescription="Timer Icon" />

    <ImageView
        android:id="@+id/notif_btn_pause_resume"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_notification_action_circle"
        android:src="@drawable/ic_notif_pause"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:contentDescription="Pause or Resume" />

    <TextView
        android:id="@+id/notif_timer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@id/notif_timer_icon"
        android:layout_toEndOf="@id/notif_timer_icon"
        android:layout_toLeftOf="@id/notif_btn_pause_resume"
        android:layout_toStartOf="@id/notif_btn_pause_resume"
        android:layout_centerVertical="true"
        android:layout_marginLeft="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginEnd="12dp"
        android:text="18:59"
        android:textColor="#FF3B30"
        android:textSize="26sp"
        android:textStyle="bold"
        android:includeFontPadding="false" />

</RelativeLayout>
